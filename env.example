# Copy to .env in the repository root. Do not commit .env.
# cp env.example .env

# --- Database ---
CIWA_DB_NAME=ciwa
CIWA_DB_USER=ciwa
CIWA_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root

# --- CRM admin (first login) ---
CIWA_ADMIN_PASSWORD=change-me-admin

# --- OAuth client used by integration middleware ---
CIWA_CLIENT_ID=ciwa-integration
CIWA_CLIENT_SECRET=change-me-client-secret

# --- URLs (set to your real server IP or domain) ---
# Browser-facing UI URL (what employees open)
CIWA_PUBLIC_URL=http://YOUR_SERVER_IP:8443
# Core URL as seen by browsers / outbound links
CIWA_CORE_PUBLIC_URL=http://YOUR_SERVER_IP:8081
# Core URL as seen by integration on the same host
CIWA_CORE_URL=http://127.0.0.1:8081

# Set to 1 only when CIWA_PUBLIC_URL is https://
CIWA_COOKIE_SECURE=0

# Match the Linux user that owns the project files on the server
HOST_UID=1000
HOST_GID=1000

# Optional: ports for host-run services (systemd / deploy/bootstrap-server.sh)
CIWA_BFF_PORT=8787
CIWA_UI_PORT=8443
